# Required. There is no default: a missing DATABASE_URL fails at boot rather
# than letting the app start against an unintended database.
DATABASE_URL=postgresql+psycopg2://activity:activity@localhost:5432/activity_hub

# Comma-separated list of origins allowed to call the API (the Vite dev server).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Reject uploads larger than this (bytes). 20 MiB covers a very long TCX.
# Whole request bodies are capped at this plus 1 MiB of multipart framing.
MAX_UPLOAD_BYTES=20971520

# IANA timezone used to bucket activities whose file states no UTC offset.
DISPLAY_TIMEZONE=Europe/Rome

# Activities from the same user starting within this many seconds, in the same
# sport, are treated as one session exported twice.
DUPLICATE_WINDOW_SECONDS=300

# The single user this deployment serves. scripts.ensure_user creates this row
# if it does not exist; an existing user is never renamed.
DEFAULT_USERNAME=athlete
DEFAULT_EMAIL=athlete@localhost

# Hard ceiling on track points returned by one request, whatever max_points asks.
MAX_TRACK_POINTS=20000

# Verbose SQL echo and tracebacks. Never enable in production: it logs data.
DEBUG=false
