# Copy to .env before `docker compose up`. These are the local defaults; change
# the password before this stack is reachable by anything but your laptop.
POSTGRES_USER=activity
POSTGRES_PASSWORD=activity
POSTGRES_DB=activity_hub

# Where the API finds the database. Compose builds this itself out of the three
# values above, so leave it alone for a Docker run — it is needed only when you
# run the API on your own machine, where nothing else supplies it and startup
# fails without it.
# DATABASE_URL=postgresql+psycopg2://activity:activity@localhost:5432/activity_hub

# IANA zone used to bucket activities whose file states no UTC offset.
DISPLAY_TIMEZONE=Europe/Rome

# Maximum heart rate for zone boundaries. Left unset, the highest beat any
# activity recorded is used — which is a floor, not a maximum: a figure nobody
# has ever pushed to reads low and makes every zone read high. Set it if you
# know yours from a test.
# MAX_HEART_RATE=187

# Published ports.
WEB_PORT=8080
API_PORT=8000

# Only needed if something other than the bundled dashboard calls the API.
CORS_ORIGINS=

# The name `scripts.ensure_user` gives the profile it creates, for a headless
# setup that never opens the first-run screen.
# DEFAULT_FIRST_NAME=Athlete

# How close two activities of the same sport must start to count as the same
# session exported twice. Five minutes.
# DUPLICATE_WINDOW_SECONDS=300
