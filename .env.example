# Copy to .env before `docker compose up`. These are the local defaults; change
# the password before this stack is reachable by anything but your laptop.
POSTGRES_USER=activity
POSTGRES_PASSWORD=activity
POSTGRES_DB=activity_hub

# IANA zone used to bucket activities whose file states no UTC offset.
DISPLAY_TIMEZONE=Europe/Rome

# Maximum heart rate for zone boundaries. Left unset, the highest beat any
# activity recorded is used — which is a floor, not a maximum: a figure nobody
# has ever pushed to reads low and makes every zone read high. Set it if you
# know yours from a test.
# MAX_HEART_RATE=187

# Published ports.
WEB_PORT=8080
API_PORT=8000

# Only needed if something other than the bundled dashboard calls the API.
CORS_ORIGINS=
